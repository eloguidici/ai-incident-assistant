# Valores locales de demostración. No usarlos fuera de esta máquina.
DATABASE_URL=postgres://app:app@localhost:5432/incident_assistant
# JWT_SECRET: obligatorio, mínimo 32 caracteres. Generar uno fuerte, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   openssl rand -base64 48
JWT_SECRET=generate-with-openssl-rand-base64-32
WEB_ORIGIN=http://localhost:5173
LLM_PROVIDER=mock
# Operator-only feature flag. False explicitly permits unprotected content.
# Internal detector failure never changes this flag or falls back to originals.
PII_ENABLED=true
# Optional name-model layer. False protects detected email/phone only, never names.
PII_PERSON_ENABLED=true
PII_SERVICE_URL=http://127.0.0.1:18080
PII_TIMEOUT_MS=10000
# Seconds a busy detector may keep the next request waiting. 0 rejects at once.
PII_SLOT_WAIT_SECONDS=20
# Generate once with npm run pii:init-key. This is a file path, never a key value.
PII_HMAC_KEY_PATH=./.local/pii-hmac.key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
# Low-cost paid model. Free-tier models did not hold the output contract for follow-up questions.
# Catalog: https://openrouter.ai/models?order=pricing-low-to-high
OPENROUTER_MODEL=openai/gpt-4o-mini
RETENTION_DAYS=30
LLM_DEADLINE_MS=20000
LLM_ATTEMPT_TIMEOUT_MS=18000
LLM_MAX_OUTPUT_TOKENS=4096
CONTEXT_CHAR_BUDGET=12000
# Measured starting limits for the CPU detector; increasing them requires latency QA.
# React reads these effective API limits at runtime; no web rebuild is needed.
SOURCE_TEXT_MAX=1000
QUESTION_MAX=500
PORT=3001
JWT_TTL_SECONDS=28800
# false for HTTP local (docker-compose / Vite). Terraform sets true behind HTTPS on AWS; do not set true without TLS.
COOKIE_SECURE=false
SEED_DEMO=true
ALLOW_SEED_DEMO=true
SEED_PASSWORD='Demo1234$'
TRUST_PROXY=false
RATE_LIMIT_ANALYSES_PER_HOUR=20
RATE_LIMIT_QUESTIONS_PER_HOUR=40
LOGIN_MAX_ATTEMPTS=10
MAX_INFLIGHT_LLM=4
FAULT_INJECTION=false
E2E_RESET=false
