# Valores locales de demostración. No usarlos fuera de esta máquina.
DATABASE_URL=postgres://app:app@localhost:5432/incident_assistant
# JWT_SECRET: obligatorio, mínimo 32 caracteres. Generar uno fuerte, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   openssl rand -base64 48
JWT_SECRET=generate-with-openssl-rand-base64-32
WEB_ORIGIN=http://localhost:5173
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
# Free tier (live rubric verified 2026-09-30): liquid/lfm-2.5-2.6b:free. Paid dev: openai/gpt-4o-mini
# Catalog: https://openrouter.ai/models?order=pricing-low-to-high
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
RETENTION_DAYS=30
LLM_DEADLINE_MS=20000
LLM_ATTEMPT_TIMEOUT_MS=12000
LLM_MAX_OUTPUT_TOKENS=4096
CONTEXT_CHAR_BUDGET=12000
SOURCE_TEXT_MAX=8000
QUESTION_MAX=1000
PORT=3001
JWT_TTL_SECONDS=28800
COOKIE_SECURE=false
SEED_DEMO=true
ALLOW_SEED_DEMO=true
SEED_PASSWORD=local-demo-password
TRUST_PROXY=false
RATE_LIMIT_ANALYSES_PER_HOUR=20
RATE_LIMIT_QUESTIONS_PER_HOUR=40
LOGIN_MAX_ATTEMPTS=10
MAX_INFLIGHT_LLM=4
FAULT_INJECTION=false
E2E_RESET=false
