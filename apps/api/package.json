{
  "name": "@app/api",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.json && node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test --max-warnings=0",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:unit": "jest --runInBand --testPathPatterns=unit",
    "migrate": "tsx src/cli.ts migrate",
    "rollback": "tsx src/cli.ts rollback",
    "seed": "tsx src/cli.ts seed",
    "seed:test": "tsx src/cli.ts seed-test",
    "reset": "tsx src/cli.ts reset",
    "eval": "tsx src/evaluation/run.ts",
    "live": "node --use-system-ca --import tsx src/evaluation/live.ts",
    "live-openrouter": "node --use-system-ca --import tsx src/evaluation/live.ts --provider openrouter"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "joi": "^18.1.1",
    "jsonwebtoken": "^9.0.2",
    "openai": "^5.20.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.26",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.36.0",
    "jest": "^30.1.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
