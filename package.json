{
  "name": "ai-incident-assistant",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "pii:init-key": "node scripts/init-pii-key.mjs",
    "qa:pii": "node scripts/qa-local-pii.mjs",
    "dev:api": "npm run start:dev -w @app/api",
    "dev:web": "npm run dev -w @app/web",
    "build": "npm run build -w @app/api && npm run build -w @app/web",
    "lint": "npm run lint -w @app/api && npm run lint -w @app/web",
    "typecheck": "npm run typecheck -w @app/api && npm run typecheck -w @app/web",
    "test": "npm run test -w @app/api",
    "test:coverage": "npm run test:coverage -w @app/api",
    "test:web": "npm run test -w @app/web",
    "test:unit": "npm run test:unit -w @app/api",
    "db:migrate": "npm run migrate -w @app/api",
    "db:rollback": "npm run rollback -w @app/api",
    "db:seed": "npm run seed -w @app/api",
    "qa:reset": "npm run reset -w @app/api",
    "qa:seed": "npm run seed:test -w @app/api",
    "qa:eval": "npm run eval -w @app/api",
    "qa:security:signals": "npm run test -w @app/api -- --testPathPatterns=prompt-injection",
    "qa:ai:live": "npm run live -w @app/api",
    "qa:ai:live-openrouter": "npm run live-openrouter -w @app/api",
    "qa:ai:suite": "npm run live-suite -w @app/api --",
    "qa:ai:assessment": "node --use-system-ca scripts/qa-live-assessment.cjs",
    "qa:openrouter:ping": "node --use-system-ca apps/api/scripts/openrouter-ping.mjs",
    "qa:smoke": "npm run build -w @app/api && playwright test --project=e2e qa/e2e/smoke.spec.ts",
    "qa:e2e": "npm run build -w @app/api && playwright test --project=e2e",
    "qa:e2e:flows": "npm run build -w @app/api && playwright test --project=flows",
    "qa:e2e:flows:limits": "npm run build -w @app/api && node scripts/qa-flows-limits.mjs",
    "qa:e2e:compose": "playwright test --config=playwright.compose.config.ts",
    "qa:docker:timeouts": "node --test qa/docker/proxy-timeouts.test.mjs",
    "qa:e2e:headed": "npm run build -w @app/api && playwright test --project=e2e --headed",
    "qa:demo": "npm run build -w @app/api && playwright test --project=demo",
    "check:web-docs": "node scripts/check-web-build.mjs",
    "docker:export-ca": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export-docker-extra-ca.ps1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  },
  "overrides": {
    "js-yaml@5": "5.4.2"
  },
  "engines": {
    "node": ">=22"
  }
}
